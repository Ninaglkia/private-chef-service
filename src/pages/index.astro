---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ChefCarousel from '../components/ChefCarousel.astro';
import { reviews as curatedReviews, platforms, type Review } from '../lib/reviews';
import { createClient } from '@supabase/supabase-js';

// Guest reviews shown in #reviews = curated platform reviews (lib/reviews.ts)
// + APPROVED user-submitted reviews from the DB, fetched server-side with the
// service role (page is output:'server'). Media lives in the PRIVATE
// 'review-media' bucket, so photo/video URLs are 1-hour signed links minted
// here — never public URLs. Newest 12 approved rows keep the homepage fast.
interface DisplayReview {
  source: Review['source'] | 'site';
  rating: number;
  quote: string;
  author: string;
  occasion?: string | null;
  location?: string | null;
  date: string;
  url?: string;
  photos: string[];
  video: string | null;
}

let siteReviews: DisplayReview[] = [];
try {
  const supabaseAdmin = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
    { auth: { persistSession: false, autoRefreshToken: false } }
  );
  const { data: rows } = await supabaseAdmin
    .from('reviews')
    .select('id, created_at, name, rating, review_text, occasion, location, photos, video_path')
    .eq('status', 'approved')
    .order('created_at', { ascending: false })
    .limit(12);

  const paths: string[] = [];
  for (const r of rows ?? []) {
    for (const p of Array.isArray(r.photos) ? r.photos : []) if (typeof p === 'string') paths.push(p);
    if (r.video_path) paths.push(r.video_path);
  }
  const signedByPath = new Map<string, string>();
  if (paths.length) {
    const { data: signed } = await supabaseAdmin.storage
      .from('review-media')
      .createSignedUrls(paths, 3600);
    for (const s of signed ?? []) if (s.path && s.signedUrl) signedByPath.set(s.path, s.signedUrl);
  }
  siteReviews = (rows ?? []).map((r) => ({
    source: 'site' as const,
    rating: r.rating,
    quote: r.review_text,
    author: r.name,
    occasion: r.occasion,
    location: r.location,
    date: r.created_at,
    photos: (Array.isArray(r.photos) ? r.photos : [])
      .map((p: unknown) => (typeof p === 'string' ? signedByPath.get(p) : undefined))
      .filter((u: string | undefined): u is string => !!u),
    video: r.video_path ? signedByPath.get(r.video_path) ?? null : null,
  }));
} catch (e) {
  // The homepage must render even if the reviews fetch fails.
  console.error('Homepage reviews fetch failed:', e);
}

// One grid, newest first — curated platform reviews and site reviews look identical.
const allReviews: DisplayReview[] = [
  ...curatedReviews.map((r) => ({ ...r, photos: [] as string[], video: null })),
  ...siteReviews,
].sort((a, b) => String(b.date).localeCompare(String(a.date)));
